rules_version = '2';

// IIGW Capacity Console — Firestore security rules
// Paste into Firebase console → Firestore Database → Rules, then Publish.
//
// Who can do what:
//   • Only signed-in accounts that have a document users/{uid} can read anything.
//   • users/{uid}.role must be "viewer" (read only) or "admin" (read + write).
//   • Optional users/{uid}.mustChangePassword = true (boolean): the person must set their own password
//     on first sign-in; until then they cannot read any data.
//   • Optional users/{uid}.backbone = true (boolean): can see the Backbone (PRTG map) section.
//   • Nobody can create users/{uid} or change a role from the website; admins add people in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    // Approved, and not still on a temporary password
    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().data.role in ['viewer', 'admin']
        && profile().data.get('mustChangePassword', false) != true;
    }
    function isAdmin() {
      return isMember() && profile().data.role == 'admin';
    }

    // Daily capacity data: one document per date
    match /days/{day} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Zain & Asia Customer QoS: one document per date, same access as days
    match /operators/{day} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Console settings. config/backbone holds the PRTG map link (with PRTG's secret key): only accounts whose
    // users/{uid} has backbone = true (boolean) may read or change it. Other config docs: members read, admins write.
    function hasBackbone() {
      return isMember() && profile().data.get('backbone', false) == true;
    }
    match /config/{doc} {
      allow read: if (doc == 'backbone' && hasBackbone()) || (doc != 'backbone' && isMember());
      allow write: if isAdmin() && (doc != 'backbone' || hasBackbone());
    }

    // Each person may read only their own access record.
    // The only change they may make is clearing mustChangePassword after setting their own password;
    // role and everything else can only be changed in the Firebase console.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && resource.data.get('mustChangePassword', false) == true
        && request.resource.data.mustChangePassword == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'passwordChangedAt']);
      allow create, delete: if false;
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
